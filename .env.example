# =========================
# App
# =========================
APP_NAME=car-mechanic-rag
ENV=prod
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=*

# =========================
# Auth (API)
# =========================
ADMIN_API_KEY=change-me-admin-key
JWT_SECRET=change-me-super-secret
JWT_ISSUER=car-mechanic-rag
JWT_AUDIENCE=car-mechanic-rag-users
JWT_EXPIRES_MINUTES=43200

# =========================
# Google Gemini (AI Studio)
# =========================
GOOGLE_API_KEY=your-google-ai-studio-key
ELEVEN_LABS_API_KEY=sua_chave_aqui
# =========================
# Optional: Vertex AI (if you prefer)
# =========================
# GOOGLE_GENAI_USE_VERTEXAI="true"
# GOOGLE_CLOUD_PROJECT="your-project-id"
# GOOGLE_CLOUD_LOCATION="us-central1"

# =========================
# Postgres / PgVector
# =========================
DB_URL=postgresql+psycopg://ai:ai@postgres:5432/ai

# =========================
# Knowledge / Vector table
# =========================
KB_TABLE=mechanic_kb
KB_MAX_RESULTS=12

# Gemini Embedder settings
EMBED_MODEL=models/text-embedding-004
EMBED_DIMENSIONS=768
EMBED_BATCH=true
EMBED_BATCH_SIZE=100

# =========================
# Ingestion
# =========================
DATASET_DIR=/data/dataset_mecanica_full
INGEST_CONCURRENCY=8
INGEST_SKIP_IF_EXISTS=true
